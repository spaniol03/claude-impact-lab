# Copie para .env e ajuste conforme o ambiente. O .env NÃO é versionado.
# Nenhuma credencial é necessária: a aplicação lê apenas dados públicos anonimizados.

# Origens permitidas para CORS (frontend). Lista separada por vírgula.
CIV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Diretório com os agregados JSON gerados pelo ETL (relativo à pasta backend/).
CIV_DATA_DIR=app/data

# Diretório com as bases brutas — usado SOMENTE pelo ETL, não pela API.
CIV_SOURCE_DIR=../../Bases de dados/dadoscreche-main

# Banco de dados das inscrições enviadas.
# Vazio = SQLite local em app/data/inscricoes.db (arquivo, sem credenciais).
# Em produção, aponte para o banco gerido pela TI, ex.:
#   CIV_DB_URL=postgresql+psycopg://usuario:senha@host:5432/matricula
CIV_DB_URL=

# Ambiente: development | production
CIV_ENV=development
